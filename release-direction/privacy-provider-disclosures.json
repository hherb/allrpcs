    {
      "id": "D07",
      "topic": "diagnostics",
      "statement": "Generation diagnostic value has provider/status/failure/timing/token fields; optional caller-owned recording. Inspected ordinary composition installs no diagnostic telemetry sink. Explicit credit links open a browser.",
