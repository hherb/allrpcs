    {
      "id": "D05",
      "topic": "credentials",
      "statement": "Explicit UI save/delete use OS-specific OpenAI credential stores; input cleared after submission, no process-memory-erasure or key-revocation guarantee.",
      "source_paths": [
        "game/OpenAiCredentialController.cs",
