      ],
      "evidence_kind": "source_inspection"
    },
    {
      "id": "D04",
      "topic": "role_requests",
      "statement": "Additional OpenAI participation/role requests can send heard dialogue and fictional character backgrounds/goals and eligible action/object/evidence context.",
