    "source_project_input_section_sha256": "8089b24704132b26cffade01e355a1715c9f513bc7dea40cd7130e450512b36c",
    "log_sha256": "de171ab1162f11fee8924b88941de76ab079e87620bfcbc6d5486f865daf0760",
    "limits": "No product scene, input changes, hardware events, or device-support claim. Initial sandbox log-directory crash; identical host retry completed.",
    "inspector_source": "extends SceneTree\nfunc _initialize():\n    var rows = []\n    for action in [\"ui_accept\", \"ui_cancel\", \"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\", \"ui_focus_next\", \"ui_focus_prev\"]:\n        var events = []\n        for event in InputMap.action_get_events(action):\n            var row = {\"class\": event.get_class(), \"device\": event.device, \"text\": event.as_text()}\n            if event is InputEventKey:\n                row.merge({\"keycode\": event.keycode, \"physical_keycode\": event.physical_keycode, \"shift\": event.shift_pressed, \"ctrl\": event.ctrl_pressed, \"alt\": event.alt_pressed, \"meta\": event.meta_pressed})\n            if event is InputEventJoypadButton:\n                row[\"button_index\"] = event.button_index\n            if event is InputEventJoypadMotion:\n                row[\"axis\"] = event.axis\n                row[\"axis_value\"] = event.axis_value\n            events.append(row)\n        rows.append({\"action\": action, \"deadzone\": InputMap.action_get_deadzone(action), \"events\": events})\n    print(\"REMAP_UI_DEFAULTS=\" + JSON.stringify({\"engine\": Engine.get_version_info(), \"actions\": rows}))\n    quit()\n",
    "successful_log": "Godot Engine v4.6.3.stable.mono.official.7d41c59c4 - https://godotengine.org\n\nREMAP_UI_DEFAULTS={\"actions\":[{\"action\":\"ui_accept\",\"deadzone\":0.5,\"events\":[{\"alt\":false,\"class\":\"InputEventKey\",\"ctrl\":false,\"device\":0,\"keycode\":4194309,\"meta\":false,\"physical_keycode\":0,\"shift\":false,\"text\":\"Enter\"},{\"alt\":false,\"class\":\"InputEventKey\",\"ctrl\":false,\"device\":0,\"keycode\":4194310,\"meta\":false,\"physical_keycode\":0,\"shift\":false,\"text\":\"Kp Enter\"},{\"alt\":false,\"class\":\"InputEventKey\",\"ctrl\":false,\"device\":0,\"keycode\":32,\"meta\":false,\"physical_keycode\":0,\"shift\":false,\"text\":\"Space\"}]},{\"action\":\"ui_cancel\",\"deadzone\":0.5,\"events\":[{\"alt\":false,\"class\":\"InputEventKey\",\"ctrl\":false,\"device\":0,\"keycode\":4194305,\"meta\":false,\"physical_keycode\":0,\"shift\":false,\"text\":\"Escape\"}]},{\"action\":\"ui_left\",\"deadzone\":0.5,\"events\":[{\"alt\":false,\"class\":\"InputEventKey\",\"ctrl\":false,\"device\":0,\"keycode\":4194319,\"meta\":false,\"physical_keycode\":0,\"shift\":false,\"text\":\"Left\"},{\"button_index\":13,\"class\":\"InputEventJoypadButton\",\"device\":-1,\"text\":\"Joypad Button 13 (D-pad Left)\"},{\"axis\":0,\"axis_value\":-1.0,\"class\":\"InputEventJoypadMotion\",\"device\":-1,\"text\":\"Joypad Motion on Axis 0 (Left Stick X-Axis, Joystick 0 X-Axis) with Value -1.00\"}]},{\"action\":\"ui_right\",\"deadzone\":0.5,\"events\":[{\"alt\":false,\"class\":\"InputEventKey\",\"ctrl\":false,\"device\":0,\"keycode\":4194321,\"meta\":false,\"physical_keycode\":0,\"shift\":false,\"text\":\"Right\"},{\"button_index\":14,\"class\":\"InputEventJoypadButton\",\"device\":-1,\"text\":\"Joypad Button 14 (D-pad Right)\"},{\"axis\":0,\"axis_value\":1.0,\"class\":\"InputEventJoypadMotion\",\"device\":-1,\"text\":\"Joypad Motion on Axis 0 (Left Stick X-Axis, Joystick 0 X-Axis) with Value 1.00\"}]},{\"action\":\"ui_up\",\"deadzone\":0.5,\"events\":[{\"alt\":false,\