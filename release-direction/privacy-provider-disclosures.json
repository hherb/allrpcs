    {
      "id": "D02",
      "topic": "composition",
      "statement": "Ordinary reply composition handles OpenAI and loopback Ollama; Anthropic yields no ordinary binding. The unavailable fallback returns failure with no generated response.",
      "source_paths": [
        "game/TemporaryCharacterModelCompositionController.cs",
        "game/TemporaryCharacterModelSource.cs",
        "game/CharacterModelSettingsController.cs",
        "game/TemporaryCharacterModelSettingsPanel.cs"
