      "15"
    ]
  ],
  "parity_runner": "python3 audio-direction/hand-tool-runtime-review/checks/run-parity.py",
  "format_command": [
    "dotnet",
    "format",
    "Allrpcs.sln",
    "--no-restore",
    "--verify-no-changes"
  ],
  "full_quality_command": "./quality.sh",
  "unit_commands": [
    [
      "dotnet",
      "test",
      "tests/Domain.Tests/Allrpcs.Domain.Tests.csproj",
      "--no-build",
      "--filter",
      "FullyQualifiedName~HandToolTap"
    ],
    [
      "dotnet",
      "test",
