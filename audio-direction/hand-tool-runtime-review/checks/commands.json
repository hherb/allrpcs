{
  "native_views_command": [
    "env",
    "ALLRPCS_CHARACTER_MODEL_COMPOSITION_DISABLED=1",
    "ALLRPCS_ORDINARY_PARTICIPATION_SMOKE_MODEL=1",
    "ALLRPCS_TOOL_MAIN_CHECK=1",
    "ALLRPCS_TOOL_MODE=views",
    "ALLRPCS_TOOL_VIEWS=/Users/hherb/src/allrpcs/audio-direction/hand-tool-runtime-review/views",
