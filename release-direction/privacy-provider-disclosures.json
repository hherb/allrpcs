    },
    {
      "id": "D03",
      "topic": "dialogue_requests",
      "statement": "Ordinary dialogue request serializes current utterance, character context/model and structured instructions; OpenAI Responses uses store=false and authentication headers; local Ollama endpoint is numeric loopback.",
      "source_paths": [
        "src/Infrastructure/Dialogue/CharacterModelRequestContent.cs",
